{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/unit/cities.test.mjs tests/unit/time.test.mjs tests/unit/weather.test.mjs tests/unit/settings.test.mjs tests/unit/layout.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
